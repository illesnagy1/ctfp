{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "htmlWhitespaceSensitivity": "ignore",
  "printWidth": 120,
  "singleQuote": true,
  "sortImports": {},
  "sortPackageJson": {},
  "sortTailwindcss": {
    "stylesheet": "./src/routes/layout.css"
  },
  "svelte": {},
  "ignorePatterns": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "bun.lockb",
    "/static/"
  ]
}
