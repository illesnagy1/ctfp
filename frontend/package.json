{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "concurrently --group --names oxfmt,oxlint,eslint \"oxfmt --check .\" \"oxlint .\" \"eslint .\"",
    "format": "oxfmt",
    "gen:api": "openapi-typescript ../api/openapi.json -o src/lib/types/api.d.ts && bun scripts/gen-schemas.ts && oxfmt src/lib/types/api.d.ts src/lib/types/schemas.ts",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "dependencies": {
    "@lucide/svelte": "^1.0.0",
    "@sjsf-lab/shadcn-extras-theme": "^3.4.3",
    "@sjsf/form": "^3.9.0",
    "@sjsf/lucide-icons": "^3.9.0",
    "@sjsf/shadcn4-theme": "^3.5.0",
    "@sjsf/sveltekit3": "^3.9.0",
    "@sjsf/zod4-validator": "^3.9.0",
    "@sveltejs/kit": "^3.0.0",
    "@tanstack/svelte-table": "^9.2.6",
    "bits-ui": "^2.16.5",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "pretty-bytes": "^7.2.0",
    "redis": "^6.2.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "svelte": "^5.57.1",
    "tailwind-merge": "^3.5.0",
    "unified": "^11.0.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@inlang/paraglide-js": "^2.25.4",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.62.0",
    "@shadcn/lint": "^0.2.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/browser-playwright": "^5.0.1",
    "bits-ui": "^2.20.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "formsnap": "^2.1.0",
    "globals": "^17.12.0",
    "mdsvex": "^0.12.8",
    "mode-watcher": "^1.1.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.63.0",
    "runed": "^0.38.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "svelte-sonner": "^1.2.0",
    "svelte-toolbelt": "^0.10.6",
    "sveltekit-superforms": "^3.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vitest-browser-svelte": "^3.1.0",
    "zod": "^4.4.3"
  }
}
