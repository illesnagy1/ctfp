# Stage 1: Build Application
FROM eclipse-temurin:25-jdk-alpine AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/root/.gradle ./gradlew buildFatJar --no-daemon
RUN mkdir /data

# Stage 2: Create the Runtime Image
FROM gcr.io/distroless/java25-debian13:nonroot AS runtime
EXPOSE 8080
COPY --from=build /src/build/libs/*-all.jar /app/api.jar
COPY --from=build --chown=65532:65532 /data /data
ENV SETTINGS_FILE=/data/settings.conf
ENV UPLOADS_DIR=/data/uploads
VOLUME /data
ENV JDK_JAVA_OPTIONS="-XX:+UseCompactObjectHeaders -XX:+UseG1GC -XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError"
ENTRYPOINT ["/usr/bin/java","-jar","/app/api.jar"]
